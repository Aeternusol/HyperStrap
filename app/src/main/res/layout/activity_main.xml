<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">

<LinearLayout android:id="@+id/mainColumn" android:layout_width="match_parent" android:layout_height="match_parent" android:animateLayoutChanges="true" android:orientation="vertical">

<LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
<com.google.android.material.card.MaterialCardView android:id="@+id/themeButton" android:layout_width="44dp" android:layout_height="44dp" android:clickable="true" android:contentDescription="Change accent color" android:focusable="true" app:cardBackgroundColor="#D0BCFF" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeWidth="0dp" />
<com.google.android.material.card.MaterialCardView android:id="@+id/statusPill" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="18dp">
<View android:id="@+id/statusDot" android:layout_width="10dp" android:layout_height="10dp" />
<TextView android:id="@+id/statusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:singleLine="true" android:text="Checking..." android:textColor="#E3E3E3" android:textSize="15sp" />
<ImageView android:id="@+id/busySpinner" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Working" android:src="@drawable/ic_cookie" android:visibility="gone" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
</LinearLayout>

<com.google.android.material.card.MaterialCardView android:id="@+id/connectCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="4dp" android:layout_marginEnd="16dp" android:layout_marginBottom="8dp" android:visibility="gone" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/hintText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E3E3E3" android:textSize="14sp" />
<com.google.android.material.button.MaterialButton android:id="@+id/requestButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Grant Shizuku permission" android:textColor="#101418" android:visibility="gone" app:backgroundTint="#D0BCFF" app:cornerRadius="24dp" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<FrameLayout android:id="@+id/contentFrame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

<ScrollView android:id="@+id/tabTweaks" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="128dp">

<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Tweaks selected" android:textColor="#E3E3E3" android:textSize="16sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="bottom" android:orientation="horizontal">
<TextView android:id="@+id/countText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-light" android:text="0" android:textColor="#FFFFFF" android:textSize="56sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingBottom="12dp" android:text="  / 6" android:textColor="#9AA0A6" android:textSize="18sp" />
</LinearLayout>
<LinearLayout android:id="@+id/segRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Performance" android:textColor="#E3E3E3" android:textSize="16sp" />
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cbFps" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="Uncap FPS" android:textColor="#E3E3E3" android:textSize="15sp" />
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cbFpsCounter" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="FPS counter" android:textColor="#E3E3E3" android:textSize="15sp" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Graphics" android:textColor="#E3E3E3" android:textSize="16sp" />
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cbSky" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="Gray sky" android:textColor="#E3E3E3" android:textSize="15sp" />
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cbGrass" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="Remove grass" android:textColor="#E3E3E3" android:textSize="15sp" />
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cbShadows" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="Disable shadows (best effort)" android:textColor="#E3E3E3" android:textSize="15sp" />
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cbTextures" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="Low textures" android:textColor="#E3E3E3" android:textSize="15sp" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<com.google.android.material.button.MaterialButton android:id="@+id/applyButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Apply  ·  restarts Roblox" android:textColor="#101418" app:backgroundTint="#D0BCFF" app:cornerRadius="28dp" />

</LinearLayout>
</ScrollView>

<ScrollView android:id="@+id/tabFlags" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="128dp">

<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Flag packs" android:textColor="#E3E3E3" android:textSize="16sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Copy a JSON flag file, then import it. Long-press a pack to delete it." android:textColor="#9AA0A6" android:textSize="13sp" />
<TextView android:id="@+id/packEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="No packs yet." android:textColor="#9AA0A6" android:textSize="13sp" />
<LinearLayout android:id="@+id/packList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:animateLayoutChanges="true" android:orientation="vertical" />
<com.google.android.material.button.MaterialButton android:id="@+id/importPackButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Import from clipboard" android:textColor="#101418" app:backgroundTint="#D0BCFF" app:cornerRadius="24dp" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Custom flags" android:textColor="#E3E3E3" android:textSize="16sp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Paste FFlags as JSON, or import a file." android:textColor="#9AA0A6" android:textSize="13sp" />
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#2A2F35" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<EditText android:id="@+id/customInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:fontFamily="monospace" android:gravity="top|start" android:hint="{&quot;FFlagExample&quot;: true}" android:inputType="textMultiLine|textNoSuggestions" android:minLines="4" android:padding="14dp" android:textColor="#E3E3E3" android:textColorHint="#7A8087" android:textSize="13sp" />
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.button.MaterialButton android:id="@+id/addCustomButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Add flags" android:textColor="#101418" app:backgroundTint="#D0BCFF" app:cornerRadius="24dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/importButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Import file" android:textColor="#E3E3E3" app:backgroundTint="#2A2F35" app:cornerRadius="24dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/exportButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Export" android:textColor="#E3E3E3" app:backgroundTint="#2A2F35" app:cornerRadius="24dp" />
</LinearLayout>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

</LinearLayout>
</ScrollView>

<LinearLayout android:id="@+id/tabApplied" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:visibility="gone">
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="52dp" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="26dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<EditText android:id="@+id/flagSearch" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:hint="Search applied flags" android:imeOptions="actionSearch" android:inputType="text|textNoSuggestions" android:maxLines="1" android:paddingStart="20dp" android:paddingEnd="20dp" android:textColor="#E3E3E3" android:textColorHint="#7A8087" android:textSize="15sp" />
</com.google.android.material.card.MaterialCardView>
<TextView android:id="@+id/appliedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginTop="12dp" android:textColor="#9AA0A6" android:textSize="13sp" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/flagRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:clipToPadding="false" android:overScrollMode="never" android:paddingBottom="128dp" />
</LinearLayout>

<ScrollView android:id="@+id/tabLog" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="128dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/viewButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="View flags" android:textColor="#E3E3E3" app:backgroundTint="#1B1F23" app:cornerRadius="26dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/removeButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="4dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Remove all" android:textColor="#D0BCFF" app:cornerRadius="26dp" app:strokeColor="#D0BCFF" />
</LinearLayout>

<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<TextView android:id="@+id/outputText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:hint="Output appears here." android:minHeight="160dp" android:padding="20dp" android:textColor="#E3E3E3" android:textColorHint="#7A8087" android:textIsSelectable="true" android:textSize="13sp" />
</com.google.android.material.card.MaterialCardView>

</LinearLayout>
</ScrollView>

</FrameLayout>
</LinearLayout>

<View android:id="@+id/bottomScrim" android:layout_width="match_parent" android:layout_height="150dp" android:layout_gravity="bottom" />

<LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
<com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" app:cardBackgroundColor="#1B1F23" app:cardCornerRadius="32dp" app:cardElevation="0dp" app:strokeColor="#2A2F35" app:strokeWidth="1dp">
<FrameLayout android:id="@+id/navTrack" android:layout_width="match_parent" android:layout_height="match_parent">
<View android:id="@+id/navIndicator" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical" />
<LinearLayout android:id="@+id/navRow" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
<LinearLayout android:id="@+id/navTweaks" android:layout_width="wrap_content" android:layout_height="48dp" android:clickable="true" android:contentDescription="Tweaks" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
<ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_tune" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:text="Tweaks" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
<LinearLayout android:id="@+id/navFlags" android:layout_width="wrap_content" android:layout_height="48dp" android:clickable="true" android:contentDescription="Flags" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
<ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_flag" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:text="Flags" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
<LinearLayout android:id="@+id/navApplied" android:layout_width="wrap_content" android:layout_height="48dp" android:clickable="true" android:contentDescription="Applied" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
<ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_applied" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:text="Applied" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
<LinearLayout android:id="@+id/navLog" android:layout_width="wrap_content" android:layout_height="48dp" android:clickable="true" android:contentDescription="Log" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
<ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_list" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:text="Log" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/launchButton" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="12dp" android:clickable="true" android:contentDescription="Launch Roblox" android:focusable="true" app:cardBackgroundColor="#4A4458" app:cardCornerRadius="32dp" app:cardElevation="0dp" app:strokeWidth="0dp">
<ImageView android:id="@+id/launchIcon" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_play" />
</com.google.android.material.card.MaterialCardView>
</LinearLayout>

<FrameLayout android:id="@+id/splash" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#1B1F23" android:clickable="true" android:focusable="true">
<FrameLayout android:id="@+id/splashGroup" android:layout_width="202dp" android:layout_height="202dp" android:layout_gravity="center">
<ImageView android:id="@+id/splashCookie" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ic_badge_cookie" />
<ImageView android:id="@+id/splashLogo" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ic_badge_logo" />
</FrameLayout>
</FrameLayout>

</FrameLayout>
